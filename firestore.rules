rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, and
// publish. Anyone can READ reviews (that's the point — shared, honest
// reviews), but a review can only be written or changed by the signed-in
// user who owns it, and only with their own real user id attached, so
// nobody can post as someone else or edit another person's review.
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.productId is string
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Products a user fills in by hand when a scan/search finds nothing —
    // shared with anyone who later scans or searches for the same thing.
    // Doc id is the barcode, so a create is really "first person to add
    // this barcode"; after that it's an update by whoever adds to it
    // (kept simple: last write wins rather than merging contributions).
    match /userProducts/{barcode} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.resource.data.submittedBy == request.auth.uid
                    && request.resource.data.barcode == barcode
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow delete: if false; // no deletes from the client — ask in the app's repo issues if you need to remove one
    }
  }
}
